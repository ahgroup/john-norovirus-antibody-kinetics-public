
@article{atmar2008,
	title = {Norwalk {Virus} {Shedding} after {Experimental} {Human} {Infection}},
	volume = {14},
	issn = {1080-6040, 1080-6059},
	url = {http://dx.doi.org/10.3201/eid1410.080117},
	doi = {10.3201/eid1410.080117},
	abstract = {Noroviruses are the most common cause of viral gastroenteritis in the United States. To determine the magnitude and duration of virus shedding in feces, we evaluated persons who had been experimentally infected with Norwalk virus. Of 16 persons, clinical gastroenteritis (watery diarrhea and/or vomiting) developed in 11; symptomatic illness lasted 1-2 days. Virus shedding was first detected by reverse transcription-PCR (RT-PCR) 18 hours after participant inoculation and lasted a median of 28 days after inoculation (range 13-56 days). The median peak amount of virus shedding was 95 x 10(9) (range 0.5-1,640 x 10(9)) genomic copies/g feces as measured by quantitative RT-PCR. Virus shedding was first detected by antigen ELISA approximately 33 hours (median 42 hours) after inoculation and lasted 10 days (median 7 days) after inoculation. Understanding of the relevance of prolonged fecal norovirus excretion must await the development of sensitive methods to measure virus infectivity.},
	language = {English},
	number = {10},
	journal = {Emerging Infectious Diseases},
	author = {Atmar, Robert L. and Opekun, Antone R. and Gilger, Mark A. and Estes, Mary K. and Crawford, Sue E. and Neill, Frederick H. and Graham, David Y.},
	month = oct,
	year = {2008},
	keywords = {Adolescent, Adult, Humans, Middle Aged, Time Factors, genetics, Viral, virology, Key refs, Caliciviridae Infections, Gastroenteritis, transmission/virology, RNA, Base Sequence, Virus Shedding, DNA Primers, Norwalk virus, Feces, *Virus Shedding, Caliciviridae Infections/transmission/*virology, Clinical Protocols, DNA Primers/genetics, Feces/virology, Gastroenteritis/*virology, \{RNA, Viral/analysis/genetics\}, Norwalk virus/genetics/*isolation {\textbackslash}\& purification/pathogenicity, Viral/analysis/genetics Time Factors, analysis/genetics, genetics/isolation /\&/ purification/pathogenicity},
	pages = {1553--1557},
	file = {Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\RWH9F2W4\\Atmar et al. - 2008 - Norwalk Virus Shedding after Experimental Human In.pdf:application/pdf},
}

@article{atmar2014,
	title = {Determination of the 50\% {Human} {Infectious} {Dose} for {Norwalk} {Virus}},
	volume = {209},
	issn = {1537-6613, 0022-1899},
	url = {http://dx.doi.org/10.1093/infdis/jit620},
	doi = {10.1093/infdis/jit620},
	abstract = {Background. Noroviruses are the most common cause of gastroenteritis in the United States. An understanding of the infectious dose of these viruses is important for risk assessment studies. Methods. Healthy adults were enrolled in a randomized, double-blind, placebo-controlled evaluation of different dosages of Norwalk virus. Eligible subjects were monitored for clinical gastroenteritis, and infection status was determined. The presence of virus in vomitus was also assessed. Results. Fifty-seven persons were enrolled; 8 received placebo and an additional 8 persons were considered to be nonsusceptible on the basis of being secretor negative. Twenty-one persons were infected (all blood group O or A), and 67\% of those infected developed viral gastroenteritis. The 50\% human infectious dose was calculated to be 3.3 reverse transcription polymerase chain reaction units (approximately 1320 genomic equivalents [gEq]) for secretorpositive blood group O or A persons and 7.0 (approximately 2800 gEq) for all secretor-positive persons. The time of illness onset was inversely correlated with inoculum dose. The maximal concentration of virus shedding was higher for persons with gastroenteritis. Norwalk virus was identified in 15 of 27 (56\%) vomitus samples at a median concentration of 41 000 gEq/mL. Conclusions. The 50\% human infectious dose measured is higher than previous estimates and similar to that of other RNA viruses. Clinical Trials Registration. NCT00138476.},
	language = {English},
	number = {7},
	journal = {The Journal of Infectious Diseases},
	author = {Atmar, Robert L. and Opekun, Antone R. and Gilger, Mark A. and Estes, Mary K. and Crawford, Sue E. and Neill, Frederick H. and Ramani, Sasirekha and Hill, Heather and Ferreira, Jennifer and Graham, David Y.},
	month = apr,
	year = {2014},
	keywords = {Adult, Female, Humans, Male, Middle Aged, Young Adult, pathogenicity, virology, Key refs, Caliciviridae Infections, Gastroenteritis, Virus Shedding, infectious dose, norovirus, secretor, serology, virus shedding, Placebos, Norwalk virus, Feces, Caliciviridae Infections/*virology, Feces/virology, Gastroenteritis/*virology, Norwalk virus/*pathogenicity, administration /\&/ dosage, Placebos/administration {\textbackslash}\& dosage, Adult Caliciviridae Infections/*virology Feces/virology Female Gastroenteritis/*virology Humans infectious dose Male Middle Aged norovirus Norwalk virus/*pathogenicity Placebos/administration {\textbackslash}\& dosage secretor serology Virus Shedding Young Adult, Adult Caliciviridae Infections/*virology Feces/virology Female Gastroenteritis/*virology Humans infectious dose Male Middle Aged norovirus Norwalk virus/*pathogenicity Placebos/administration \& dosage secretor serology Virus Shedding Young Adult},
	pages = {1016--1022},
	file = {Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\ITJX7W3R\\Atmar et al. - 2014 - Determination of the 50% Human Infectious Dose for.pdf:application/pdf},
}

@article{cohen2021,
	title = {Longitudinal {Analysis} {Shows} {Durable} and {Broad} {Immune} {Memory} after {SARS}-{CoV}-2 {Infection} with {Persisting} {Antibody} {Responses} and {Memory} {B} and {T} {Cells}},
	volume = {2},
	issn = {2666-3791},
	doi = {10.1016/j.xcrm.2021.100354},
	abstract = {Ending the COVID-19 pandemic will require long-lived immunity to SARS-CoV-2. Here, we evaluate 254 COVID-19 patients longitudinally up to 8 months and find durable broad-based immune responses. SARS-CoV-2 spike binding and neutralizing antibodies exhibit a bi-phasic decay with an extended half-life of {\textgreater}200 days suggesting the generation of longer-lived plasma cells. SARS-CoV-2 infection also boosts antibody titers to SARS-CoV-1 and common betacoronaviruses. In addition, spike-specific IgG+ memory B cells persist, which bodes well for a rapid antibody response upon virus re-exposure or vaccination. Virus-specific CD4+ and CD8+ T cells are polyfunctional and maintained with an estimated half-life of 200 days. Interestingly, CD4+ T cell responses equally target several SARS-CoV-2 proteins, whereas the CD8+ T cell responses preferentially target the nucleoprotein, highlighting the potential importance of including the nucleoprotein in future vaccines. Taken together, these results suggest that broad and effective immunity may persist long-term in recovered COVID-19 patients.},
	language = {english},
	number = {7},
	journal = {Cell Reports Medicine},
	author = {Cohen, Kristen W. and Linderman, Susanne L. and Moodie, Zoe and Czartoski, Julie and Lai, Lilin and Mantus, Grace and Norwood, Carson and Nyhoff, Lindsay E. and Edara, Venkata Viswanadh and Floyd, Katharine and De Rosa, Stephen C. and Ahmed, Hasan and Whaley, Rachael and Patel, Shivan N. and Prigmore, Brittany and Lemos, Maria P. and Davis, Carl W. and Furth, Sarah and O'Keefe, James B. and Gharpure, Mohini P. and Gunisetty, Sivaram and Stephens, Kathy and Antia, Rustom and Zarnitsyna, Veronika I. and Stephens, David S. and Edupuganti, Srilatha and Rouphael, Nadine and Anderson, Evan J. and Mehta, Aneesh K. and Wrammert, Jens and Suthar, Mehul S. and Ahmed, Rafi and McElrath, M. Juliana},
	month = jul,
	year = {2021},
	keywords = {B cells, CD4 T cells, neutralizing antibody, immune memory, COVID-19, SARS-CoV-2, binding antibody, CD8 T cells, coronaviruses, immune correlates},
	pages = {100354},
	file = {Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\UB6DEURD\\Cohen et al. - 2021 - Longitudinal analysis shows durable and broad immu.pdf:application/pdf},
}

@article{degraaf2014,
	title = {A {Two}-{Phase} within-{Host} {Model} for {Immune} {Response} and {Its} {Application} to {Serological} {Profiles} of {Pertussis}},
	volume = {9},
	issn = {1755-4365},
	doi = {10.1016/j.epidem.2014.08.002},
	abstract = {We present a simple phenomenological within-host model describing both the interaction between a pathogen and the immune system and the waning of immunity after clearing of the pathogen. We implement the model into a Bayesian hierarchical framework to estimate its parameters for pertussis using Markov chain Monte Carlo methods. We show that the model captures some essential features of the kinetics of titers of IgG against pertussis toxin. We identify a threshold antibody level that separates a large increase in antibody level upon infection from a small increase and accordingly might be interpreted as a threshold separating clinical from subclinical infections. We contrast predictions of the model with observations reported in the literature and based on independent data and find a remarkable correspondence.},
	language = {english},
	journal = {Epidemics},
	author = {de Graaf, W. F. and Kretzschmar, M. E. E. and Teunis, P. F. M. and Diekmann, O.},
	month = dec,
	year = {2014},
	keywords = {Within-host model, Serology, Parameter estimation, Pertussis, Waning immunity},
	pages = {1--7},
}

@article{johnson1990,
	title = {Multiple-{Challenge} {Study} of {Host} {Susceptibility} to {Norwalk} {Gastroenteritis} in {US} {Adults}},
	volume = {161},
	issn = {0022-1899},
	url = {https://doi.org/10.1093/infdis/161.1.18},
	doi = {10.1093/infdis/161.1.18},
	abstract = {In a multiple-challenge study of US adult volunteers with low or high levels of serum antibody to Norwalk virus, Norwalk inoculum 8FIIa was administered to 42 subjects, 22 were challenged 6 months later, and 19 received a third challenge after 6 more months. All 12 with high (greater than or equal to 1:200) but only 19 of 30 with low (less than 1:100) prechallenge titers experienced illness or a fourfold increase in titer after the first challenge (P less than .025). Only 4 of those challenged twice became ill; all had low initial titers but 3 had high titers before the second challenge. None became ill after a third challenge. Nine (47\%) had high titers immediately before the third challenge; 3 had low titers before and after each challenge and remained asymptomatic. Thus, preexisting serum antibody to Norwalk virus does not seem to be associated with protective immunity, but antibody levels become associated with protection after repetitive exposure. Short-term resistance lasts greater than or equal to 6 months after challenge, and a small percentage of resistant individuals maintain low antibody titers even after multiple challenges.},
	language = {english},
	number = {1},
	urldate = {2022-02-15},
	journal = {The Journal of Infectious Diseases},
	author = {Johnson, P. C. and Mathewson, J. J. and DuPont, H. L. and Greenberg, H. B.},
	month = jan,
	year = {1990},
	pmid = {2153184},
	keywords = {Humans, Antibodies, Immunity, Viral, Antibodies, Viral, Virus Diseases, Gastroenteritis, Disease Susceptibility, Norwalk virus},
	pages = {18--21},
	file = {877869:C\:\\Users\\handelgroup\\Zotero\\storage\\D59Y978M\\877869.html:text/html;877869:C\:\\Users\\handelgroup\\Zotero\\storage\\H4ZRMFA6\\877869.html:text/html;Snapshot:C\:\\Users\\handelgroup\\Zotero\\storage\\VC3T6ACY\\877869.html:text/html},
}

