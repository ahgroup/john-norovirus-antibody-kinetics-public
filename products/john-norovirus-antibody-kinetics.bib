@article{patel2008,
	title = {Systematic {Literature} {Review} of {Role} of {Noroviruses} in {Sporadic} {Gastroenteritis}},
	volume = {14},
	issn = {1080-6059},
	doi = {10.3201/eid1408.071114},
	abstract = {We conducted a systematic review of studies that used reverse transcription-PCR to diagnose norovirus (NoV) infections in patients with mild or moderate (outpatient) and severe (hospitalized) diarrhea. NoVs accounted for 12\%(95\% confidence interval [CI] 10\%-15\%) of severe gastroenteritis cases among children {\textless}5 years of age and 12\% (95\% CI 9\%-15\%) of mild and moderate diarrhea cases among persons of all ages. Of 19 studies among children {\textless}5 years of age, 7 were in developing countries where pooled prevalence of severe NoV disease (12\%) was comparable to that for industrialized countries (12\%). We estimate that each year NoVs cause 64,000 episodes of diarrhea requiring hospitalization and 900,000 clinic visits among children in industrialized countries, and up to 200,000 deaths of children {\textless}5 years of age in developing countries. Future efforts should focus on developing targeted strategies, possibly even vaccines, for preventing NoV disease and better documenting their impact among children living in developing countries, where {\textgreater}95\% of the deaths from diarrhea occur.},
	language = {english},
	number = {8},
	journal = {Emerging Infectious Diseases},
	author = {Patel, Manish M. and Widdowson, Marc-Alain and Glass, Roger I. and Akazawa, Kenichiro and Vinjé, Jan and Parashar, Umesh D.},
	month = aug,
	year = {2008},
	pmcid = {PMC2600393},
	pmid = {18680645},
	keywords = {Humans, Key refs, Disease Outbreaks, Caliciviridae Infections, Gastroenteritis, Norovirus, Caliciviridae Infections/*virology, Norovirus/*isolation {\textbackslash}\& purification, *Disease Outbreaks, Gastroenteritis/epidemiology/*virology},
	pages = {1224--1231},
	file = {Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\I9RP5EEB\\Patel et al. - 2008 - Systematic literature review of role of noroviruse.pdf:application/pdf},
}

@article{scallan2011a,
	title = {Foodborne {Illness} {Acquired} in the {United} {States}—{Major} {Pathogens}},
	volume = {17},
	issn = {1080-6040},
	doi = {10.3201/eid1701.P11101},
	abstract = {Each year, 31 pathogens caused 9.4 million episodes of foodborne illness, resulting in 55,961 hospitalizations and 1,351 deaths., Estimates of foodborne illness can be used to direct food safety policy and interventions. We used data from active and passive surveillance and other sources to estimate that each year 31 major pathogens acquired in the United States caused 9.4 million episodes of foodborne illness (90\% credible interval [CrI] 6.6–12.7 million), 55,961 hospitalizations (90\% CrI 39,534–75,741), and 1,351 deaths (90\% CrI 712–2,268). Most (58\%) illnesses were caused by norovirus, followed by nontyphoidal Salmonella spp. (11\%), Clostridium perfringens (10\%), and Campylobacter spp. (9\%). Leading causes of hospitalization were nontyphoidal Salmonella spp. (35\%), norovirus (26\%), Campylobacter spp. (15\%), and Toxoplasma gondii (8\%). Leading causes of death were nontyphoidal Salmonella spp. (28\%), T. gondii (24\%), Listeria monocytogenes (19\%), and norovirus (11\%). These estimates cannot be compared with prior (1999) estimates to assess trends because different methods were used. Additional data and more refined methods can improve future estimates.},
	number = {1},
	journal = {Emerging Infectious Diseases},
	author = {Scallan, Elaine and Hoekstra, Robert M. and Angulo, Frederick J. and Tauxe, Robert V. and Widdowson, Marc-Alain and Roy, Sharon L. and Jones, Jeffery L. and Griffin, Patricia M.},
	month = jan,
	year = {2011},
	pmcid = {PMC3375761},
	pmid = {21192848},
	pages = {7--15},
	file = {Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\RGDBB9QY\\Scallan et al. - 2011 - Foodborne Illness Acquired in the United States—Ma.pdf:application/pdf},
}

@article{treanor2014,
	title = {A {Novel} {Intramuscular} {Bivalent} {Norovirus} {Virus}-like {Particle} {Vaccine} {Candidate}–{Reactogenicity}, {Safety}, and {Immunogenicity} in a {Phase} 1 {Trial} in {Healthy} {Adults}},
	volume = {210},
	issn = {1537-6613},
	url = {http://dx.doi.org/10.1093/infdis/jiu337},
	doi = {10.1093/infdis/jiu337},
	abstract = {BACKGROUND: Noroviruses are the most important viral causes of gastroenteritis-related morbidity and mortality. A randomized, double-blind, placebo-controlled study evaluated an adjuvanted bivalent intramuscular norovirus virus-like particle (VLP) vaccine. METHODS: Forty-eight adults aged 18-49 years received either 2 doses containing genotype GI.1 VLP and a consensus GII.4 VLP or 2 doses of placebo. Doses (5 µg, 15 µg, 50 µg, or 150 µg of each VLP) were administered 4 weeks apart in the first stage. Subsequently, 54 adults, aged 18-49 (n=16), 50-64 (n=19), and 65-85 (n=19) years, received 2 doses of vaccine containing 50 µg of each VLP. Total and class-specific antibody responses, as well as histoblood group antigen (HBGA) blocking antibody responses, were measured before and after each dose. RESULTS: Local reactions were mainly injection site pain/tenderness, with no reported fever or vaccine-related serious adverse events. One dose of vaccine containing 50 µg of each VLP increased GI.1 geometric mean titers (GMTs) by 118-fold, 83-fold, and 24-fold and increased GII.4 GMTs by 49-fold, 25-fold, and 9-fold in subjects aged 18-49, 50-64, and 65-83 years, respectively. Serum antibody responses peaked at day 7 after the first dose, with no evidence of boosting following a second dose. Most subjects achieved HBGA-blocking antibody titers of {\textbackslash}geq200. CONCLUSIONS: The vaccine was well tolerated and immunogenic. Rapid immune response to a single dose may be particularly useful in military personnel and travelers and in the control of outbreaks. Clinical Trials Registration.{\textbackslash}quadNCT01168401.},
	language = {eng},
	number = {11},
	journal = {The Journal of Infectious Diseases},
	author = {Treanor, John J. and Atmar, Robert L. and Frey, Sharon E. and Gormley, Robert and Chen, Wilbur H. and Ferreira, Jennifer and Goodwin, Robert and Borkowski, Astrid and Clemens, Ralf and Mendelman, Paul M.},
	month = dec,
	year = {2014},
	pmid = {24951828},
	keywords = {Vaccines, Adolescent, Adult, Aged, Female, Follow-Up Studies, Humans, Male, Middle Aged, Young Adult, Antibodies, immunology, Viral, Antibodies, Neutralizing, Antibodies, Viral, Injections, Intramuscular, Aged, 80 and over, Key refs, vaccine, Neutralizing, prevention /\&/ control, Caliciviridae Infections, Gastroenteritis, Norovirus, norovirus, Viral Vaccines, gastroenteritis, 80 and over, blood/immunology, Injections, Intramuscular, virus-like particle, Virus-Like Particle, Vaccines, Virus-Like Particle, Norovirus/*immunology, administration /\&/ dosage/adverse effects/immunology, \{Antibodies, \{Aged, 80 and over\}, \{Vaccines, Viral/blood/immunology\}, \{Injections, Intramuscular\vphantom{\{}\}, Viral Vaccines/administration {\textbackslash}\& dosage/adverse effects/*immunology, Caliciviridae Infections/*prevention {\textbackslash}\& control, Neutralizing/blood/immunology\}, Virus-Like Particle/administration {\textbackslash}\& dosage/adverse effects/*immunology\}, Gastroenteritis/*prevention {\textbackslash}\& control},
	pages = {1763--1771},
	file = {Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\DHBDFHBC\\Treanor et al. - 2014 - A novel intramuscular bivalent norovirus virus-lik.pdf:application/pdf;Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\GCQKH2RM\\Treanor et al. - 2014 - A novel intramuscular bivalent norovirus virus-like particle vaccine candidate--reactogenicity, safe.pdf:application/pdf},
}

@article{teunis2016,
	title = {Linking the {Seroresponse} to {Infection} to {Within}-{Host} {Heterogeneity} in {Antibody} {Production}},
	volume = {16},
	issn = {1755-4365},
	doi = {10.1016/j.epidem.2016.04.001},
	abstract = {A recently published model for the serum antibody response to infection appeared well suited for use in statistical analyses of longitudinal serological data. The published model assumed exponential decay with fixed rates for pathogen and serum antibody kinetics, ignoring any within-host heterogeneity in the seroresponse. A bi-exponential model shows that there is rapid initial decay followed by a prolonged period of persistent low serum antibody concentrations. We propose a small modification of the decay model that greatly increases its flexibility by allowing for non-exponential antibody decay. The modified model produces power functions that may be interpreted as a mixture of exponential decay curves, with a mixing distribution representing the relative contribution of many centres of antibody production to the serum antibody concentration. Fitting the power function decay model to observed longitudinal data for pertussis shows improved goodness of fit compared to the exponential decay model, with estimates for the shape parameter (r=2.2; 95\% CI (1.7–2.8)) that differ from exponential shape (r=1). The power function decay model predicts more persistent antibody concentrations in the long term (symptomatic threshold reached {\textgreater}30 years after infection) which, when used in biomarker studies, will lead to lower estimates of seroconversion rates compared to exponential antibody decay.},
	language = {english},
	journal = {Epidemics},
	author = {Teunis, P. F. M. and van Eijkeren, J. C. H. and de Graaf, W. F. and Marinović, A. Bonačić and Kretzschmar, M. E. E.},
	month = sep,
	year = {2016},
	keywords = {Within-host model, Serology, Parameter estimation, Pertussis, Waning immunity},
	pages = {33--39},
	file = {Full Text:C\:\\Users\\handelgroup\\Zotero\\storage\\VHDDU5WQ\\Teunis et al. - 2016 - Linking the seroresponse to infection to within-ho.pdf:application/pdf},
}

