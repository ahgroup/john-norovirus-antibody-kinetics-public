	journal = {Emerging Infectious Diseases},
	author = {Ge, Yang and Billings, W. Zane and Opekun, Antone and Estes, Mary and Graham, David and Leon, Juan and Koelle, Katia and Shen, Ye and Atmar, Robert and Lopman, Benjamin and Handel, Andreas},
