	keywords = {Humans, Vaccination, Antibodies, Viral, Immunoglobulin G, vaccine, Immunity, Humoral, COVID-19, SARS-CoV-2, BNT162 Vaccine, COVID-19 Vaccines, IgG, 2019-nCoV Vaccine mRNA-1273, Ad26COVS1, antibody response, Breakthrough Infections, vaccine breakthrough},
	pages = {e439--e449},
}

