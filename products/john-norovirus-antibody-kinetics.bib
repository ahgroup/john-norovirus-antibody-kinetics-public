	author = {Isakbaeva, Elmira T. and Widdowson, Marc-Alain and Beard, R. Suzanne and Bulens, Sandra N. and Mullins, James and Monroe, Stephan S. and Bresee, Joseph and Sassano, Patricia and Cramer, Elaine H. and Glass, Roger I.},
